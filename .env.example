# Binance — testnet keys (from testnet.binance.vision)
TESTNET_API_KEY=
TESTNET_SECRET_KEY=

# Binance — live keys (add when ready to go live)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Toggle: True = testnet, False = live
USE_TESTNET=True

# Amount of USDT to spend per DCA buy
USDT_AMOUNT=30.0

# Telegram bot (from @BotFather) + your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard login password
DASHBOARD_PASSWORD=your_secure_password_here

# PostgreSQL — Railway provides this automatically as DATABASE_URL
# For local dev: postgresql://user:password@localhost:5432/dcabot
DATABASE_URL=
